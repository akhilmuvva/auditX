{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@auditx/types": ["./types/index.ts"]
    }
  },
  "include": ["legacy/src/**/*", "test/**/*", "types/**/*", "scripts/**/*"],
  "exclude": [
    "test/AgentRegistry.test.ts",
    "test/AuditBadgeNFT.test.ts",
    "test/AuditJobQueue.test.ts",
    "test/AuditRegistry.test.ts",
    "test/ResumeRegistry.test.ts",
    "scripts/deploy.ts",
    "scripts/deploySubgraph.ts",
    "scripts/startAgent.ts"
  ]
}
