# ─────────────────────────────────────────────────────────────────────────────
# AuditX SIEM Configuration — Environment Template
# ─────────────────────────────────────────────────────────────────────────────

# Server Configuration
PORT=3000
NODE_ENV=production
AUDITX_API_TOKEN=prod_auditx_admin_secret_key_change_me

# Tenant Store Configuration (memory | file | sqlite | postgres)
AUDITX_STORE_TYPE=postgres
DATABASE_URL=postgresql://auditx:auditx_secure_pass@localhost:5432/auditx_db
AUDITX_SQLITE_PATH=./reports-cache/auditx.sqlite
AUDITX_REGISTRY_PATH=./reports-cache/auditx-tenant-registry.json
AUDITX_DLQ_PATH=./reports-cache/auditx-dlq.json

# Polygon Streamer & PolyLance Escrow Monitor
POLYGON_RPC_URLS=https://polygon.gateway.tenderly.co,https://polygon-bor-rpc.publicnode.com
POLYLANCE_FACTORY_ADDRESS=0xbE74923BBfd72d400a681915dBcf6e6Adc72C317
POLYLANCE_ADMIN_ADDRESSES=0xc0Af73834fc45E88664e94D98B77cde62Fc1139E,0x2BfAAE968b81C1817647498660088F74e1B4cAE3
POLYLANCE_ARBITRATOR_ADDRESSES=0x25F6C8ed995C811E6c0ADb1D66A60830E8115e9A,0x62cDfc0692cC675c95304BaCE2C834D8F901dCba
POLYGON_CONFIRMATIONS=2
CURSOR_FILE_PATH=./reports-cache/streamer-cursor.json

# Rust Identity Auth Service Configuration
AUDITX_IDENTITY_URL=http://localhost:8080
AUDITX_IDENTITY_SERVICE_KEY=identity_service_secret_key_change_me
